# FlowShield server-side secrets. Copy to .env and fill in. Never commit .env.
#
# The backend tries Anthropic first, then Google. Either one alone is enough;
# with both, Google is the free fallback when Anthropic is unavailable.

# Anthropic Claude (paid, primary). https://platform.claude.com -> API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google AI Studio (free tier, fallback). https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
