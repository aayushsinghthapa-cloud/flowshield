# FlowShield server-side secrets. Copy to .env and fill in. Never commit .env.
#
# The backend tries Google first (free, ~5 s), then Anthropic (paid, no daily cap).
# Either one alone is enough. Flip the order with AI_PROVIDER_ORDER.

# Anthropic Claude (paid, fallback). https://platform.claude.com -> API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google AI Studio (free tier, primary). https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional: comma-separated provider order (default: google,anthropic)
# AI_PROVIDER_ORDER=google,anthropic
